---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ buildDate }}</lastmod>
    {%- for c in clips %}
    <video:video>
      <video:thumbnail_loc>{{ site.url }}/assets/posters/{{ c.slug }}.jpg</video:thumbnail_loc>
      <video:title>{{ c.title }}</video:title>
      <video:description>{{ c.summary }}</video:description>
      <video:content_loc>{{ site.url }}/videos/{{ c.slug }}.mp4</video:content_loc>
    </video:video>
    {%- endfor %}
  </url>
  <url><loc>{{ site.url }}/thinking/</loc><lastmod>{{ buildDate }}</lastmod></url>
  {%- for p in collections.thinking %}
  <url><loc>{{ p.url | abs(site.url) }}</loc><lastmod>{{ (p.data.updated or p.date) | isoDate }}</lastmod></url>
  {%- endfor %}
</urlset>
