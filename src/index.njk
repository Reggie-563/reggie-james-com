{%- if collections.thinking.length or feeds.length %}
<section class="band" id="thinking-latest" aria-labelledby="th-h">
  <div class="wrap">
    <div class="pe-head th-head">
      <h2 class="h-sec" id="th-h">Thinking</h2>
      <p>Articles and notes on go-to-market, brand, AI and building technology businesses.</p>
    </div>
    {%- set own = collections.thinking | head(3) %}
    {%- if own.length %}
    <ul class="posts">
      {%- for p in own %}
      <li class="post-card"><a href="{{ p.url }}">
        <span class="pc-meta">{{ p.date | ukDate }}</span>
        <h3>{{ p.data.title }}</h3>
        <p>{{ p.data.description }}</p>
        <span class="pc-more">Read the article</span>
      </a></li>
      {%- endfor %}
    </ul>
    {%- elif feeds.length %}
    <ul class="posts">
      {%- for f in feeds | head(3) %}
      <li class="post-card"><a href="{{ f.url }}" target="_blank" rel="noopener">
        <span class="pc-meta">{{ f.source }}{% if f.date %}, {{ f.date | ukDate }}{% endif %}</span>
        <h3>{{ f.title }}</h3>
        <p>{{ f.excerpt }}</p>
        <span class="pc-more">Read on {{ f.source }}</span>
      </a></li>
      {%- endfor %}
    </ul>
    {%- endif %}
    <a class="textlink" href="/thinking/">All thinking</a>
  </div>
</section>
{%- endif %}

<section class="band faq" id="questions" aria-labelledby="faq-h">
  <div class="wrap faq-grid">
    <h2 class="h-sec" id="faq-h">Questions</h2>
    <div class="faq-list">
      {%- for f in faqs %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="band contact" id="contact" aria-labelledby="ct-h">
  <div class="wrap">
    <h2 class="big cond" id="ct-h">Let's talk</h2>
    <div class="contact-grid">
      <div class="contact-copy">
        <p class="cl">Building, scaling or backing a technology business and need a clear route to market? Tell me a little about it and I will come back to you personally.</p>
        <p class="cs">Prefer LinkedIn? <a href="https://www.linkedin.com/in/reggiejames" target="_blank" rel="noopener">Message me there</a>.</p>
      </div>
      <form class="form" id="contactForm" novalidate data-endpoint="{{ site.formEndpoint }}">
        <div class="row2">
          <label class="field"><span>Name</span><input id="f-name" name="name" type="text" autocomplete="name" required></label>
          <label class="field"><span>Email</span><input id="f-email" name="email" type="email" autocomplete="email" required></label>
        </div>
        <label class="field"><span>Company <i>optional</i></span><input id="f-company" name="company" type="text" autocomplete="organization"></label>
        <label class="field"><span>How can I help?</span>
          <span class="sel"><select id="f-topic" name="topic" required>
            <option value="" selected disabled>Choose one</option>
            <option>Consultancy and advisory</option>
            <option>Marketing and sales growth</option>
            <option>A one-to-one conversation</option>
            <option>Appear on the Perspectives podcast</option>
            <option>Invite me as a guest or speaker</option>
            <option>Something else</option>
          </select></span>
        </label>
        <label class="field"><span>Message</span><textarea id="f-msg" name="message" rows="4" required placeholder="A few lines on what you are working on"></textarea></label>
        <label class="hp" aria-hidden="true">Leave this empty<input id="f-hp" name="_gotcha" type="text" tabindex="-1" autocomplete="off"></label>
        <div class="fsend">
          <button type="submit" class="btn solid" id="f-send">Send message</button>
          <p class="fstatus" id="f-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>
