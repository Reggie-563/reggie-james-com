<section class="band contact" id="contact" aria-labelledby="ct-h">
  <div class="wrap">
    <h2 class="big cond" id="ct-h">Let's talk</h2>
    <div class="contact-grid">
      <div class="contact-copy">
        <p class="cl">What is the growth decision you would like a second opinion on?</p>
        <p class="cl-sub">Whether you are planning your next stage of growth, wondering why marketing is not producing pipeline, or assessing an investment, I would welcome a conversation. I reply personally.</p>
        <p class="cs">Prefer LinkedIn? <a href="https://www.linkedin.com/in/reggiejames" target="_blank" rel="noopener">Message me there</a>.</p>
      </div>
      <form class="form" id="contactForm" novalidate action="{{ site.formEndpoint }}" method="POST" data-endpoint="{{ site.formEndpoint }}">
        <input type="hidden" name="_subject" id="f-subject" value="New enquiry from reggie-james.com">
        <div class="row2">
          <label class="field"><span>Name</span><input id="f-name" name="name" type="text" autocomplete="name" required></label>
          <label class="field"><span>Email</span><input id="f-email" name="email" type="email" autocomplete="email" required></label>
        </div>
        <label class="field"><span>Company <i>optional</i></span><input id="f-company" name="company" type="text" autocomplete="organization"></label>
        <label class="field"><span>How can I help?</span>
          <span class="sel"><select id="f-topic" name="topic" required>
            <option value="" selected disabled>Choose one</option>
            <option>Go-to-market strategy</option>
            <option>Marketing and pipeline</option>
            <option>Execution or fractional leadership</option>
            <option>Investor: due diligence or portfolio support</option>
            <option>A one-to-one conversation</option>
            <option>Podcast, speaking or media</option>
            <option>Something else</option>
          </select></span>
        </label>
        <label class="field"><span>Message</span><textarea id="f-msg" name="message" rows="4" required placeholder="A few lines on the decision or situation you are facing"></textarea></label>
        <label class="hp" aria-hidden="true">Leave this empty<input id="f-hp" name="_gotcha" type="text" tabindex="-1" autocomplete="off"></label>
        <div class="fsend">
          <button type="submit" class="btn solid" id="f-send">Send message</button>
          <p class="fstatus" id="f-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>
</section>
